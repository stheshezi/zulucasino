        </mxCell>
        <mxCell id="normalUnsecured" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="Build Remains Unsecured&#xa;Opponent May Manipulate Upward If Legal" vertex="1">
