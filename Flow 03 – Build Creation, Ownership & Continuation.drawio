        </mxCell>
        <mxCell id="secured" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Build Secured&#xa;Opponent Cannot Manipulate&#xa;Opponent May Only Capture / Eat Legally" vertex="1">
