        <mxCell id="normalCreate" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Create Unsecured Build&#xa;Target = X&#xa;Owner = Player" vertex="1">
